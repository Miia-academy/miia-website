# ==============================================================================
# MIIA Website - environment variables template
# Copy to .env.local and fill in the values for your environment.
# Variables marked "optional" have a default in the code.
# ==============================================================================

# --- Storyblok ---
NEXT_PUBLIC_STORYBLOK_PREVIEW=your_storyblok_preview_token
STORYBLOK_MANAGEMENT=your_storyblok_management_token
# optional: token for /api/config/skills (falls back to the preview token)
STORYBLOK_TOKEN=
# optional: "true" shows draft content in production
STORYBLOK_FORCE_DRAFT=

# --- Brevo ---
BREVO_TOKEN=your_brevo_api_key
BREVO_MANAGEMENT=your_brevo_management_key
BREVO_STUDENT_LIST_ID=42
BREVO_BUSINESS_LIST_ID=30
BREVO_BUSINESS_REQUESTS_LIST_ID=8
# optional: company list used by the admin job page (default 43)
BREVO_AZIENDE_LIST_ID=
# optional: comma-separated Brevo lists the site forms may write to
CRM_ALLOWED_LISTS=
# Visit source (ORIGINE_* and ULTIMA_*) on Brevo contacts and events.
# Turn on only after the attributes exist in Brevo.
CRM_SOURCE_ATTRIBUTES=on

# --- Online enrollment ---
# "on" shows the online enrollment
ENROLLMENT_ONLINE=
# optional: sender, office copy and SMS sender (default iscrizione@miia.it, MIIA)
ENROLLMENT_SENDER_EMAIL=
ENROLLMENT_OFFICE_EMAIL=
ENROLLMENT_SMS_SENDER=

# --- Site banners ---
# "on" shows the banners in production (always on in previews and locally)
BANNER_SITO=

# --- Tracking and consent ---
# Tag Manager container, loaded only in production
NEXT_PUBLIC_GTM=
# optional: Iubenda cookie policy id
NEXT_PUBLIC_IUBENDA_COOKIE_POLICY_ID=

# --- Mapbox ---
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token

# --- Sessions and links in emails ---
JWT_SECRET=your_super_secret_jwt_signing_key
NEXT_PUBLIC_BASE_URL=http://localhost:8080
# optional: address the browser tests (Playwright) run against
BASE_URL=http://localhost:8080

# --- Neon Postgres ---
DATABASE_URL=postgresql://username:password@ep-sample-pooler.eu-central-1.aws.neon.tech/miia_db?sslmode=require

# --- Admin (/admin): without both, admin login is disabled ---
ADMIN_EMAIL=admin@miia.it
ADMIN_PASSWORD=your_admin_strong_password

# --- Google Cloud Storage (logos, CVs and portfolios) ---
GCS_BUCKET_PUBLIC=miia-assets
GCS_BUCKET_PRIVATE=miia-documents
GCS_CLIENT_EMAIL=service-account@miia-project.iam.gserviceaccount.com
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
