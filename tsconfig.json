{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@pages/*": ["./pages/*"],
      "@components/*": ["./components/*"],
      "@styles/*": ["./styles/*"],
      "@modules/*": ["./modules/*"],
      "@public/*": ["./public/*"],
      "@config/*": ["./config/*"],
      "@types": ["./.storyblok/types/311109/storyblok-components"],
      "@commonTypes": ["./.storyblok/types/storyblok.d.ts"],
      "@props/*": ["./props/*"],
      "@crm/*": ["./crm/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "**/*.txt"]
}